# Copy to .env.local (or .env) and fill in. .env.local wins if both exist.
# Both files are gitignored, so never commit real values.

# Required. Neon Postgres connection string.
# Use the pooled URL (host contains "-pooler") for the app and on Vercel.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Optional, only read by `npm run db:seed`. When set, every seeded user with an
# email (the founding team) gets this password, so you can log in as them at /login.
# Leave empty and seeded profiles have no login. Use 8+ characters (the sign-up minimum).
SEED_PASSWORD=""
