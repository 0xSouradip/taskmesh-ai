# Copy to .env.local (or .env) and fill in. .env.local wins if both exist.
# Both files are gitignored, so never commit real values.

# Required. Neon Postgres connection string.
# Use the pooled URL (host contains "-pooler") for the app and on Vercel.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Required for sign-in. Neon console -> your project -> Auth -> "Auth URL".
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth"

# Required for sign-in. Signs the session cookie cache. 32+ characters:
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# Optional. Public site URL, used for social preview links (Open Graph).
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"
